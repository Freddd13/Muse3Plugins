+            rows.push({degree:degree, label:labels.length ? labels.join(" / ") : degree,
+                       notes:played.length ? played.join(" · ") : expected ? "缺音" : "—",
+                       present:played.length > 0, expected:expected, color:Harmony.colors[degree]})
